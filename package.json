{
  "name": "aibox-control-center",
  "version": "2.0.1",
  "description": "数字员工 AI Box 控制中心 - 本地优先的桌面 Agent 管理器",
  "homepage": "https://github.com/h4dex/opc-nexus",
  "main": "out/main/index.js",
  "author": "Senke",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:quest": "node scripts/run-quest-surface.cjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "start:quest": "node scripts/run-quest-surface.cjs preview",
    "hermes:prepare": "node scripts/prepare-hermes.cjs --web --runtime",
    "hermes:verify": "node scripts/prepare-hermes.cjs",
    "hermes:smoke": "node scripts/smoke-hermes-runtime.cjs",
    "agents:prepare": "node scripts/prepare-agent-runtimes.cjs",
    "agents:verify": "node scripts/prepare-agent-runtimes.cjs --verify",
    "agents:verify:packaged": "node scripts/verify-packaged-agent-runtimes.cjs",
    "acceptance:plugins": "node scripts/acceptance-hermes-project-plugins.cjs",
    "hermes:verify:packaged": "node scripts/verify-packaged-hermes.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "website:preview": "npm --prefix website run preview",
    "mobile:apk:debug": "node scripts/mobile-apk.cjs build debug",
    "mobile:apk:release": "node scripts/mobile-apk.cjs build release",
    "mobile:icons": "node scripts/generate-android-icons.cjs",
    "mobile:apk:verify": "node scripts/mobile-apk.cjs verify",
    "mobile:apk:verify-release": "node scripts/mobile-apk.cjs verify --require-release",
    "mobile:e2e": "node scripts/mobile-e2e.cjs",
    "pack:win": "npm run mobile:apk:release && npm run hermes:prepare && npm run agents:prepare && npm run build && electron-builder --win --x64",
    "pack:linux": "npm run mobile:apk:release && npm run hermes:prepare && npm run agents:prepare && npm run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@playwright/mcp": "0.0.79",
    "@types/dompurify": "^3.0.5",
    "@types/sql.js": "^1.4.11",
    "@xyflow/react": "^12.11.2",
    "adm-zip": "0.5.18",
    "ajv": "^8.20.0",
    "cors": "^2.8.6",
    "dompurify": "^3.4.12",
    "express": "^5.2.1",
    "marked": "^18.0.7",
    "mermaid": "11.16.1",
    "onnxruntime-node": "^1.27.0",
    "playwright-core": "^1.61.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.3",
    "sql.js": "^1.14.1",
    "systeminformation": "^5.25.11",
    "ws": "^8.21.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "onnxruntime-node@1.27.0": true
  }
}
